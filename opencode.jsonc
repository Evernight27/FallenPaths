{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "keligrubb": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Keligrubb AI",
      "options": {
        "baseURL": "https://ai.keligrubb.com/api/v1",
        "apiKey": "sk-c77c3f620ea84170861fdd248fa48946"
      },
      "models": {
        "qwen3.6-35b-a3b": {
          "name": "Qwen 3.6 35B A3B",
          "limit": {
            "context": 120000,
            "output": 8192
          }
        }
      }
    }
  },
  "lsp": {
    "gdscript": {
      "command": [
        "node",
        ".opencode/scripts/godot-lsp-bridge.js",
        "--godot",
        ".godot/Godot_v4.7-stable_win64.exe",
        "--project",
        "."
      ],
      "extensions": [
        ".gd",
        ".gdshader"
      ]
    }
  }
}