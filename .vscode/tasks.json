{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run Combat Regression Harness (headless)",
			"type": "shell",
			"command": "${workspaceFolder}/scripts/run_combat_regression_harness.sh",
			"options": {
				"cwd": "${workspaceFolder}",
				"env": {
					"GODOT": "${config:godotTools.editorPath.godot4:/Applications/Godot.app/Contents/MacOS/Godot}"
				}
			},
			"group": "test",
			"presentation": {
				"reveal": "always",
				"panel": "shared",
				"focus": false
			},
			"problemMatcher": []
		},
		{
			"label": "Run Medical Phase Harness (headless)",
			"type": "shell",
			"command": "${config:godotTools.editorPath.godot4:/Applications/Godot.app/Contents/MacOS/Godot}",
			"args": [
				"--headless",
				"--path",
				"${workspaceFolder}",
				"-s",
				"res://scripts/run_medical_phase_harness.gd"
			],
			"group": "test",
			"presentation": {
				"reveal": "always",
				"panel": "shared",
				"focus": false
			},
			"problemMatcher": []
		}
	]
}
