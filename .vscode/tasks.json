{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run Combat Regression Harness (headless)",
			"type": "shell",
			"command": "${config:godotTools.editorPath.godot4:/Applications/Godot.app/Contents/MacOS/Godot}",
			"args": [
				"--headless",
				"--path",
				"${workspaceFolder}",
				"-s",
				"res://scripts/run_combat_regression_harness.gd"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"group": "test",
			"presentation": {
				"reveal": "always",
				"panel": "shared",
				"focus": false
			},
			"problemMatcher": [
				{
					"owner": "fallen-paths-harness",
					"fileLocation": ["relative", "${workspaceFolder}"],
					"pattern": [
						{
							"regexp": "^FP_HARNESS_FAIL: \\[\\d+/\\d+\\] (.+)$",
							"message": 1
						},
						{
							"regexp": "^FP_(COMBAT|WORLD|ERROR): (.+)$",
							"message": 2
						},
						{
							"regexp": "^FP_WARN: (.+)$",
							"message": 1,
							"severity": "warning"
						},
						{
							"regexp": "^\\s*at: (res:\\/\\/[^:]+):(\\d+)(?::[^:]*)?$",
							"file": 1,
							"line": 2,
							"message": 0
						},
						{
							"regexp": "^SCRIPT ERROR: (.+)$",
							"message": 1,
							"severity": "error"
						}
					]
				}
			]
		},
		{
			"label": "Run Medical Phase Harness (headless)",
			"type": "shell",
			"command": "${config:godotTools.editorPath.godot4:/Applications/Godot.app/Contents/MacOS/Godot}",
			"args": [
				"--headless",
				"--path",
				"${workspaceFolder}",
				"-s",
				"res://scripts/run_medical_phase_harness.gd"
			],
			"group": "test",
			"presentation": {
				"reveal": "always",
				"panel": "shared",
				"focus": false
			},
			"problemMatcher": [
				{
					"owner": "fallen-paths-harness",
					"fileLocation": ["relative", "${workspaceFolder}"],
					"pattern": [
						{
							"regexp": "^FP_HARNESS_FAIL: \\[\\d+/\\d+\\] (.+)$",
							"message": 1
						},
						{
							"regexp": "^FP_(COMBAT|WORLD|ERROR): (.+)$",
							"message": 2
						},
						{
							"regexp": "^\\s*at: (res:\\/\\/[^:]+):(\\d+)(?::[^:]*)?$",
							"file": 1,
							"line": 2,
							"message": 0
						},
						{
							"regexp": "^SCRIPT ERROR: (.+)$",
							"message": 1,
							"severity": "error"
						}
					]
				}
			]
		}
	]
}
