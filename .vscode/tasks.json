{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run Combat Regression Harness (headless)",
			"type": "shell",
			"command": "${config:godotTools.editorPath.godot4:/Applications/Godot.app/Contents/MacOS/Godot}",
			"args": [
				"--headless",
				"--path",
				"${workspaceFolder}",
				"-s",
				"res://scripts/run_all_combat_checks.gd"
			],
			"options": {
				"cwd": "${workspaceFolder}",
				"env": {
					"FP_HARNESS_MODE": "regression"
				}
			},
			"group": "test",
			"presentation": {
				"reveal": "always",
				"panel": "shared",
				"focus": false
			},
			"problemMatcher": [
				{
					"owner": "fallen-paths-harness",
					"fileLocation": ["relative", "${workspaceFolder}"],
					"pattern": [
						{
							"regexp": "^FP_HARNESS_FAIL: \\[\\d+/\\d+\\] (.+)$",
							"message": 1
						},
						{
							"regexp": "^FP_(COMBAT|WORLD|ERROR): (.+)$",
							"message": 2
						},
						{
							"regexp": "^FP_WARN: (.+)$",
							"message": 1,
							"severity": "warning"
						},
						{
							"regexp": "^\\s*at: (res:\\/\\/[^:]+):(\\d+)(?::[^:]*)?$",
							"file": 1,
							"line": 2,
							"message": 0
						},
						{
							"regexp": "^SCRIPT ERROR: (.+)$",
							"message": 1,
							"severity": "error"
						}
					]
				}
			]
		},
		{
			"label": "Run All Combat Checks (headless)",
			"type": "shell",
			"command": "bash",
			"args": ["${workspaceFolder}/scripts/run_all_combat_checks.sh"],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"group": "test",
			"presentation": {
				"reveal": "always",
				"panel": "shared",
				"focus": false
			},
			"problemMatcher": [
				{
					"owner": "fallen-paths-harness",
					"pattern": [
						{
							"regexp": "^FP_HARNESS_FAIL: (.+)$",
							"message": 1
						},
						{
							"regexp": "^FP_HARNESS_SUMMARY: (.+)$",
							"message": 1
						}
					]
				}
			],
			"windows": {
				"command": "powershell",
				"args": [
					"-NoProfile",
					"-ExecutionPolicy",
					"Bypass",
					"-File",
					"${workspaceFolder}/scripts/run_all_combat_checks.ps1"
				]
			}
		},
		{
			"label": "Run D-001 Soak Harness (headless)",
			"type": "shell",
			"command": "${config:godotTools.editorPath.godot4:/Applications/Godot.app/Contents/MacOS/Godot}",
			"args": [
				"--headless",
				"--path",
				"${workspaceFolder}",
				"-s",
				"res://scripts/run_all_combat_checks.gd"
			],
			"options": {
				"cwd": "${workspaceFolder}",
				"env": {
					"FP_HARNESS_MODE": "d001"
				}
			},
			"group": "test",
			"presentation": {
				"reveal": "always",
				"panel": "shared",
				"focus": false
			},
			"problemMatcher": [
				{
					"owner": "fallen-paths-harness",
					"fileLocation": ["relative", "${workspaceFolder}"],
					"pattern": [
						{
							"regexp": "^FP_HARNESS_FAIL: \\[\\d+/\\d+\\] (.+)$",
							"message": 1
						},
						{
							"regexp": "^FP_HARNESS_FAIL: (.+)$",
							"message": 1
						},
						{
							"regexp": "^FP_D001_SOAK_REPORT",
							"message": 0
						}
					]
				}
			]
		},
		{
			"label": "Run Medical Phase Harness (headless)",
			"type": "shell",
			"command": "${config:godotTools.editorPath.godot4:/Applications/Godot.app/Contents/MacOS/Godot}",
			"args": [
				"--headless",
				"--path",
				"${workspaceFolder}",
				"-s",
