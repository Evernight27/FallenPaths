						{
							"regexp": "^FP_HARNESS_FAIL: (.+)$",
							"message": 1
						}
					]
				}
			]
		},
		{
			"label": "Validate F5 Soak Log",
			"type": "shell",
			"command": "bash",
			"args": ["${workspaceFolder}/scripts/validate_f5_soak_log.sh"],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"group": "test",
			"windows": {
				"command": "powershell",
				"args": [
					"-NoProfile",
					"-ExecutionPolicy",
					"Bypass",
					"-File",
					"${workspaceFolder}/scripts/validate_f5_soak_log.ps1"
				]
			},
			"presentation": {
				"reveal": "always",
				"panel": "shared",
				"focus": false
			},
			"problemMatcher": [
				{
					"owner": "fallen-paths-harness",
					"pattern": [
						{
							"regexp": "^FP_HARNESS_FAIL: (.+)$",
							"message": 1
						},
						{
							"regexp": "^\\[([^\\]]+)\\] FAIL — (.+)$",
							"message": 2
						}
					]
				}
			]
		},
		{
			"label": "Run F5 Soak Suite (headless + validate log)",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"${workspaceFolder}/scripts/run_all_combat_checks.ps1",
				"-ValidateF5"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"group": "test",
			"presentation": {
				"reveal": "always",
				"panel": "shared",
				"focus": false
			},
			"problemMatcher": [
				{
					"owner": "fallen-paths-harness",
					"pattern": [
						{
							"regexp": "^FP_HARNESS_FAIL: (.+)$",
							"message": 1
						}
					]
				}
			]
		},
		{
