{
  // Set "godotTools.editorPath.godot4" in settings.local.json (git-ignored) or
  // your user settings. Hard-coding a local Godot path here breaks for everyone else.
  "[gdscript]": {
    "editor.insertSpaces": true,
    "editor.tabSize": 4,
    "editor.detectIndentation": false
  },
  "files.associations": {
    "*.gd": "gdscript"
  }
}
