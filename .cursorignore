# Reduce indexer noise (regenerable / binary-heavy)
.godot/
.import/
/android/
*.tmp

# Godot import sidecars (one per asset; rarely needed for script edits)
**/*.import

# Python
__pycache__/
docs/__pycache__/
*.py[cod]

# Local harness / playtest artifacts (repo root; mirror .gitignore)
# Phase 0 gate outputs
.harness_*.txt
.phase0_*
.d001_*
.calibration_audit.txt
.campaign_ship_audit.txt
.ii2b_worksheet_prefill.txt
.q_track_audits.txt

# Phase 0 / harness scratch (transient temp files)
scripts/.tmp_*
.tmp_*
phase0_raw_output*.txt
regression_debug.txt
_regression_direct.txt

# F5 human playtest paste
.f5_soak_in.txt
.f5_soak_validation.txt

# Editor-local overrides (machine-specific Godot path, etc.)
.vscode/settings.local.json