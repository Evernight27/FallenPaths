# Reduce indexer noise (regenerable / binary-heavy)
.godot/
.import/
/android/
*.tmp

# Godot import sidecars (one per asset; rarely needed for script edits)
**/*.import

# Python
__pycache__/
docs/__pycache__/
*.py[cod]

# Local harness / playtest artifacts (repo root; mirror .gitignore)
# Duplicate camp smokes — canonical: docs/camp_optional_step_smokes/
.camp_optional_tests/

# Phase 0 gate outputs
.harness_*.txt
.phase0_*
.d001_*
.company_checks_out_*.txt
.gate_out.txt
